# Canonical names (either scheme works — next.config.ts maps the SUPABASE_* names
# into the NEXT_PUBLIC_* names the browser needs at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Equivalent alternative names (e.g. from the Vercel Supabase integration):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
